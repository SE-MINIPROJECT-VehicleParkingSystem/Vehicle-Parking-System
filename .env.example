# Root-level standalone admin workspace
MONGODB_URI=mongodb://127.0.0.1:27017/vehicle_parking?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
SEED_ADMIN_NAME=Parking Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_STAFF_NAME=Parking Staff
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=ChangeThisStaffPassword123!
SEED_ZONES=A,B,C
SLOTS_PER_ZONE=10
